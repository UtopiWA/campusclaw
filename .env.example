# Copy this file to .env and replace every replace-* placeholder.
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=replace-with-a-random-app-password
MYSQL_HOST_PORT=3306

# Local demonstration only. Disable seeding outside local/demo environments.
DEMO_SEED_ENABLED=true
DEMO_SEED_PASSWORD=replace-with-a-demo-account-password

MAX_UPLOAD_BYTES=2097152
COOKIE_SECURE=false

# Qdrant runs only inside the Compose network and is not published to the host.
QDRANT_COLLECTION=campusclaw_chunks

# OpenAI-compatible providers. Replace placeholders locally; never commit real credentials.
EMBEDDING_BASE_URL=https://embedding-provider.example.invalid/v1
EMBEDDING_API_KEY=replace-with-an-embedding-api-key
EMBEDDING_MODEL=replace-with-an-embedding-model
EMBEDDING_DIMENSION=1024
CHAT_BASE_URL=https://chat-provider.example.invalid/v1
CHAT_API_KEY=replace-with-a-chat-api-key
CHAT_MODEL=replace-with-a-chat-model

RETRIEVAL_CONNECT_TIMEOUT=3s
RETRIEVAL_READ_TIMEOUT=30s
