# Copy this file to .env and replace every replace-* placeholder.
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=replace-with-a-random-app-password
MYSQL_HOST_PORT=3306

# Local demonstration only. Disable seeding outside local/demo environments.
DEMO_SEED_ENABLED=true
DEMO_SEED_PASSWORD=replace-with-a-demo-account-password

MAX_UPLOAD_BYTES=2097152
COOKIE_SECURE=false
